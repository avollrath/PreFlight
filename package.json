{
  "name": "preflight",
  "private": true,
  "version": "0.0.0",
  "description": "A Windows-first productivity checklist gate.",
  "author": "PreFlight",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "npm run dev:locked",
    "dev:locked": "npm run clean:electron && cross-env PREFLIGHT_DEV_LOCKED=1 concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\" \"npm:dev:electron:run\"",
    "dev:safe": "npm run dev:debug",
    "dev:debug": "npm run clean:electron && cross-env PREFLIGHT_DEV_SAFE=1 PREFLIGHT_DEV_DEBUG=1 concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\" \"npm:dev:electron:run\"",
    "dev:renderer": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:electron": "wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 npm run build:electron:watch",
    "dev:electron:run": "wait-on dist-electron/main.cjs http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 node scripts/dev-launch-electron.cjs",
    "clean:electron": "node -e \"require('fs').rmSync('dist-electron', { recursive: true, force: true })\"",
    "build": "tsc -b && npm run build:electron && vite build",
    "build:electron": "esbuild electron/main.ts --bundle --platform=node --format=cjs --outfile=dist-electron/main.cjs --external:electron --external:electron/* && esbuild electron/preload.ts --bundle --platform=node --format=cjs --outfile=dist-electron/preload.cjs --external:electron --external:electron/*",
    "build:electron:watch": "concurrently -k \"esbuild electron/main.ts --bundle --platform=node --format=cjs --outfile=dist-electron/main.cjs --external:electron --external:electron/* --watch\" \"esbuild electron/preload.ts --bundle --platform=node --format=cjs --outfile=dist-electron/preload.cjs --external:electron --external:electron/* --watch\"",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "npm run build && electron .",
    "package": "npm run build && electron-builder --win --dir",
    "dist": "npm run build && electron-builder --win"
  },
  "build": {
    "appId": "com.preflight.productivitygate",
    "productName": "PreFlight",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "src/assets/logo.png",
        "to": "assets/logo.png"
      }
    ],
    "win": {
      "icon": "icon.ico",
      "target": [
        "nsis",
        "dir"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "three": "^0.160.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.5.0",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.27.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "wait-on": "^9.0.5"
  }
}
